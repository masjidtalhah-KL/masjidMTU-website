    "admin:bundle:check": "node scripts/admin-foundation/bundle-check.mjs",
    "admin:local:start": "node scripts/admin-foundation/local-cli.mjs start",
    "admin:local:reset": "node scripts/admin-foundation/local-cli.mjs db reset --local --no-seed",
