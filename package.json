{
  "name": "masjid-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lecture-generator:test": "node --test scripts/lecture-generator/lecture-generator.test.mjs",
    "public-content:test": "node --test scripts/public-content/public-content.test.mjs",
