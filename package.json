    "homepage-content:verify": "node scripts/public-content/homepage-verify.mjs",
    "sanity:migrate": "node scripts/sanity-migration/cli.mjs",
    "sanity:migrate:write-drafts": "node scripts/sanity-migration/cli.mjs --write-drafts",
    "sanity:migrate:test": "node --test scripts/sanity-migration/migration.test.mjs",
    "sanity:publish": "node scripts/sanity-migration/publication-cli.mjs",
    "sanity:publish:test": "node --test scripts/sanity-migration/publication.test.mjs",
    "information-content:test": "node --test scripts/public-content/information-content.test.mjs",
