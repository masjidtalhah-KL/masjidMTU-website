    "admin:local:test": "node --test scripts/admin-foundation/local-supabase.test.mjs",
    "admin:smoke": "node scripts/admin-foundation/route-smoke.mjs",
    "admin:e2e": "playwright test -c scripts/admin-foundation/playwright.config.ts",
    "campaign:local:test": "node --test scripts/campaign-engine/local-database.test.mjs",
    "campaign:upgrade:test": "node --test scripts/campaign-engine/upgrade.test.mjs",
    "campaign:flags:test": "node --import tsx --test scripts/campaign-engine/flags-contract.test.ts scripts/campaign-engine/flags-upgrade.test.mjs",
    "campaign:flags:local:test": "node --import tsx --test scripts/campaign-engine/flags-local.test.mjs"
  },
  "overrides": {
    "supabase": {
      "tar": "7.5.22"
    }
  },
  "dependencies": {
    "@sanity/client": "8.9.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.6",
    "next-sanity": "13.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "6.17.0",
    "server-only": "0.0.1",
    "styled-components": "6.5.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "supabase": "2.78.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
