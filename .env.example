# Tetapan public Sanity dan konfigurasi admin setempat/staging.
# Jangan masukkan credentials sebenar di sini.

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=
# Fasa 4.1 tidak memerlukan API/read/write token.

# Supabase / PostgreSQL — values supplied outside Git; no production mode.
ADMIN_SUPABASE_ENV=
ADMIN_SUPABASE_PROJECT_REF=
ADMIN_APP_ORIGIN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# No privileged key is required/imported by the foundation runtime.
# The following is reserved for a future separately reviewed Auth recovery setup.
SUPABASE_SECRET_KEY=
# Supabase CLI provider secret, manually configured only after staging approval.
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Email service
EMAIL_SERVICE_API_KEY=

# Payment gateway
PAYMENT_GATEWAY_SECRET_KEY=
PAYMENT_GATEWAY_WEBHOOK_SECRET=
